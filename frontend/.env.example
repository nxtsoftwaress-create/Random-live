# ── API / socket ─────────────────────────────────────────────
# Dev: leave empty to use the Vite proxy (same origin → :5000).
# Prod: full URLs, e.g. https://api.yourapp.com/api/v1
VITE_API_URL=/api/v1
VITE_SOCKET_URL=

# ── WebRTC ICE servers ───────────────────────────────────────
VITE_STUN_SERVERS=stun:stun.cloudflare.com:3478,stun:stun.l.google.com:19302
# Free TURN via OpenRelay: https://dashboard.metered.ca
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_PASSWORD=

# ── Google AdSense (monetization) ────────────────────────────
# Publisher id: AdSense → Account → Account information (ca-pub- + 16 digits).
# Leave empty to disable ads entirely — no placeholder, no script, no ads.txt.
VITE_ADSENSE_CLIENT_ID=
# Ad unit slot ids: AdSense → Ads → By ad unit → Display ads.
VITE_ADSENSE_SLOT_LANDING=
VITE_ADSENSE_SLOT_MATCHMAKING=
