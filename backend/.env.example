# ── Runtime ────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Data stores (docker compose up -d) ─────────────────────
DATABASE_URL=postgresql://randomlive:randomlive@localhost:5432/randomlive
REDIS_URL=redis://localhost:6379
# auto = use Postgres/Redis when reachable, else in-memory fallback
# memory = force in-memory (ephemeral) | real = require live services
PERSISTENCE=auto

# ── Auth secrets (generate: openssl rand -hex 32) ──────────
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me

# ── CORS / client origin ───────────────────────────────────
CLIENT_URL=http://localhost:5173

# ── WebRTC ICE servers ─────────────────────────────────────
# Comma-separated STUN list (browser fetches these from its own env)
STUN_SERVERS=stun:stun.cloudflare.com:3478,stun:stun.l.google.com:19302
# TURN fallback — create free credentials at https://dashboard.metered.ca (OpenRelay)
TURN_URL=
TURN_USERNAME=
TURN_PASSWORD=

# ── Matchmaking tuning ─────────────────────────────────────
MATCH_TICK_MS=300            # pairing loop interval
MATCH_WIDEN_MS=10000         # wait before language restriction widens to global
RECENT_PARTNER_TTL_MS=1800000  # anti-rematch window (30 min)
